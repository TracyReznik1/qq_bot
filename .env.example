# ═══════════════════════════════════════════════
# LLM Provider Chain
# ═══════════════════════════════════════════════
# Default chain (all entries with a valid API key are tried in order):
#   1. Gemini 3.1 Flash-Lite
#   2. Gemma 4 26B A4B   (text-only; skipped when tools are needed)
#   3. DeepSeek V4 Flash
#   4. DeepSeek V4 Pro
#
# Gemma 4 26B A4B is currently treated as no-tool-support.
# The flag will be updated after real-API verification.
# ═══════════════════════════════════════════════

LLM_PRIMARY_PROVIDER=gemini
LLM_PRIMARY_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_1_PROVIDER=gemini
LLM_FALLBACK_1_MODEL=gemma-4-26b-a4b-it
LLM_FALLBACK_2_PROVIDER=deepseek
LLM_FALLBACK_2_MODEL=deepseek-v4-flash
LLM_FALLBACK_3_PROVIDER=deepseek
LLM_FALLBACK_3_MODEL=deepseek-v4-pro

# Backward compatibility — usually leave empty.
# Set LLM_PROVIDER=deepseek to use DeepSeek as primary (without needing
# to fill in LLM_PRIMARY_PROVIDER above).
LLM_PROVIDER=

# Gemini / Google AI Studio
GEMINI_API_KEY=
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_MODEL=gemini-3.1-flash-lite

# DeepSeek
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_URL=https://api.deepseek.com/chat/completions

# OpenAI (reserved; not used by the default chain)
OPENAI_API_KEY=

# OneBot / NapCat / Lagrange HTTP API
ONEBOT_API_URL=http://127.0.0.1:3000
ONEBOT_ACCESS_TOKEN=
CALLBACK_SECRET=

# Bot
BOT_NAME=ATRI
BOT_HOST=127.0.0.1
BOT_PORT=5000
REQUIRE_GROUP_AT=true
ADMIN_QQ_IDS=123456,234567
BOT_PERSONA=你是 ATRI，一个 QQ 聊天机器人。说话自然、可爱、有一点吐槽感，但要友好、简洁、靠谱。

# Network
PROXY_URL=
REQUEST_TIMEOUT=18
TAVILY_API_KEY=

# Features
SEARCH_MAX_RESULTS=4
VIDEO_ENABLE_MEDIA_PIPELINE=false
VIDEO_MAX_DOWNLOAD_MB=50
VIDEO_MAX_SECONDS=600
HISTORY_TURNS=8
PERSIST_HISTORY=true
MEMORY_LIMIT=30
MAX_REPLY_CHARS=1700

# Data
DATA_DIR=atri_data

# ═══════════════════════════════════════════════
# Local ComfyUI Image Generation
# ═══════════════════════════════════════════════
# Default: OFF.  Set IMAGE_ENABLE=true after configuring ComfyUI.
IMAGE_ENABLE=false

# First edition: only /image command, never auto-triggered from chat.
IMAGE_CHAT_TOOL_ENABLE=false

# First edition recommends admin-only to avoid GPU abuse.
IMAGE_ADMIN_ONLY=true

# ComfyUI Desktop default address.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_SECONDS=600
COMFYUI_CLIENT_ID=atri-qq-bot

# AI image project root (read-only reference).
IMAGE_PROJECT_DIR=D:\Desktop\AI生图

# Default: Anima enhanced API workflow.
COMFYUI_WORKFLOW_API_PATH=D:\Desktop\AI生图\workflows\anima\03_anima_enhanced_api.json

# Default preset is highres_output (user requirement).
IMAGE_DEFAULT_PRESET=highres_output

# Fallback if highres_output runs out of VRAM.
IMAGE_FALLBACK_PRESET=final_output

# Output saved under atri_data/generated_images/.
IMAGE_OUTPUT_DIR=atri_data\generated_images

# First edition: single image only.
IMAGE_MAX_BATCH_SIZE=1

# Only one generation task at a time.
IMAGE_SINGLE_TASK_LOCK=true

# ═══════════════════════════════════════════════
# LoRA interface — reserved, disabled by default
# ═══════════════════════════════════════════════
IMAGE_USE_CHARACTER_LORA=false
IMAGE_CHARACTER_LORA_NAME=
IMAGE_CHARACTER_LORA_STRENGTH=0.0

IMAGE_USE_STYLE_LORA=false
IMAGE_STYLE_LORA_NAME=
IMAGE_STYLE_LORA_STRENGTH=0.0

# Optional ComfyUI node ID overrides (leave empty for auto-detection).
COMFYUI_POSITIVE_NODE_ID=
COMFYUI_NEGATIVE_NODE_ID=
COMFYUI_PRESET_NODE_ID=
COMFYUI_SEED_NODE_ID=
COMFYUI_WIDTH_NODE_ID=
COMFYUI_HEIGHT_NODE_ID=
COMFYUI_STEPS_NODE_ID=
COMFYUI_CFG_NODE_ID=
COMFYUI_CHARACTER_LORA_NODE_ID=
COMFYUI_STYLE_LORA_NODE_ID=
COMFYUI_SAVE_PREFIX_NODE_ID=

# ═══════════════════════════════════════════════
# Image Search (/pic command)
# ═══════════════════════════════════════════════
# Default: OFF.  Set IMAGE_SEARCH_ENABLE=true after configuring TAVILY_API_KEY.
IMAGE_SEARCH_ENABLE=false

# Search backend (first edition: tavily only).
IMAGE_SEARCH_PROVIDER=tavily

# Max candidate results to fetch from provider.
IMAGE_SEARCH_MAX_RESULTS=5

# Max images to send per /pic command (hard cap: 3).
IMAGE_SEARCH_SEND_MAX=3

# Cache directory for downloaded images.
IMAGE_SEARCH_CACHE_DIR=atri_data/image_search_cache

# Max download size per image in MB.
IMAGE_SEARCH_MAX_DOWNLOAD_MB=8
